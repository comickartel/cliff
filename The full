<style>

/* =========================================
   RESET
========================================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#03050d;
    color:white;
    overflow-x:hidden;
}

/* =========================================
   ANIMATED BACKGROUND
========================================= */

body::before{
    content:"";
    position:fixed;
    inset:0;
    z-index:-3;

    background:
        radial-gradient(
            circle at 15% 20%,
            rgba(0,100,255,.28),
            transparent 30%
        ),
        radial-gradient(
            circle at 85% 70%,
            rgba(255,0,45,.28),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #02040a,
            #08000b,
            #02040a
        );
}

body::after{
    content:"";
    position:fixed;
    inset:0;
    z-index:-2;

    opacity:.15;

    background-image:
        linear-gradient(
            rgba(0,100,255,.25) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255,0,50,.2) 1px,
            transparent 1px
        );

    background-size:45px 45px;

    animation:gridMove 15s linear infinite;
}

@keyframes gridMove{

    from{
        transform:translateY(0);
    }

    to{
        transform:translateY(45px);
    }

}

/* =========================================
   NAVBAR
========================================= */

header{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    z-index:1000;

    padding:18px 6%;

    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;

    background:rgba(2,5,15,.82);

    backdrop-filter:blur(15px);

    border-bottom:
        1px solid rgba(0,120,255,.25);

    transition:.3s;
}

.logo{
    font-size:25px;
    font-weight:900;
    letter-spacing:2px;

    color:white;

    text-shadow:
        0 0 5px #087cff,
        0 0 15px #087cff,
        0 0 30px #ff1744;

    animation:blink 2s infinite alternate;
}

@keyframes blink{

    from{
        filter:brightness(.75);
    }

    to{
        filter:brightness(1.5);
    }

}

nav{
    display:flex;
    gap:22px;
}

nav a{
    color:white;
    text-decoration:none;
    font-weight:bold;
    transition:.3s;
}

nav a:hover{
    color:#168cff;

    text-shadow:
        0 0 10px #168cff;
}

/* SEARCH */

.search{
    display:flex;
    gap:8px;
}

.search input{
    width:190px;

    padding:10px 14px;

    border-radius:30px;

    border:1px solid #147cff;

    background:#050914;

    color:white;

    outline:none;
}

.search button{
    border:none;

    border-radius:50%;

    width:40px;
    height:40px;

    background:
        linear-gradient(
            135deg,
            #087cff,
            #ff1744
        );

    color:white;

    cursor:pointer;
}

/* =========================================
   HERO
========================================= */

.hero{
    min-height:100vh;

    display:flex;
    align-items:center;

    padding:
        140px
        7%
        80px;

    position:relative;
}

.hero-content{
    max-width:720px;
}

.hero h1{
    font-size:
        clamp(
            45px,
            7vw,
            90px
        );

    line-height:.95;

    margin-bottom:25px;
}

.hero h1 span{
    background:
        linear-gradient(
            90deg,
            #087cff,
            #fff,
            #ff1744
        );

    -webkit-background-clip:text;

    color:transparent;
}

.hero p{
    color:#b9c3d8;

    font-size:18px;

    line-height:1.7;

    margin-bottom:30px;
}

.buttons{
    display:flex;
    gap:15px;
    flex-wrap:wrap;
}

.btn{
    padding:14px 25px;

    border-radius:30px;

    text-decoration:none;

    color:white;

    font-weight:bold;

    border:
        1px solid #168cff;

    background:#061020;

    transition:.3s;

    cursor:pointer;
}

.btn:hover{
    transform:translateY(-4px);

    box-shadow:
        0 0 25px #087cff;
}

.btn.primary{
    background:
        linear-gradient(
            90deg,
            #087cff,
            #ff1744
        );

    border:none;
}

/* =========================================
   SECTIONS
========================================= */

section{
    padding:90px 6%;
}

.section-title{
    font-size:38px;
    margin-bottom:35px;
}

.section-title span{
    color:#168cff;
}

/* =========================================
   FILTERS
========================================= */

.filters{
    display:flex;
    flex-wrap:wrap;
    gap:10px;

    margin-bottom:35px;
}

.filter{
    padding:10px 20px;

    border:
        1px solid #123c70;

    background:#07101e;

    color:#ddd;

    border-radius:25px;

    cursor:pointer;

    transition:.3s;
}

.filter:hover,
.filter.active{
    background:
        linear-gradient(
            90deg,
            #087cff,
            #ff1744
        );

    color:white;

    border-color:transparent;
}

/* =========================================
   MOVIE GRID
========================================= */

.movie-grid{
    display:grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(190px,1fr)
        );

    gap:25px;
}

.movie{
    background:
        rgba(8,12,25,.85);

    border:
        1px solid
        rgba(30,120,255,.25);

    border-radius:18px;

    overflow:hidden;

    transition:.4s;

    position:relative;
}

.movie:hover{
    transform:
        translateY(-10px)
        scale(1.02);

    border-color:#087cff;

    box-shadow:
        0 0 20px
        rgba(0,110,255,.3),

        0 0 30px
        rgba(255,0,50,.15);
}

.poster{
    height:285px;
    overflow:hidden;
}

.poster img{
    width:100%;
    height:100%;

    object-fit:cover;

    transition:.5s;
}

.movie:hover .poster img{
    transform:scale(1.1);
}

.movie-info{
    padding:16px;
}

.movie-info h3{
    font-size:18px;
    margin-bottom:7px;
}

.movie-info p{
    color:#8f9bb2;
    font-size:13px;
    margin-bottom:13px;
}

.trailer-btn{
    width:100%;

    padding:10px;

    border:none;

    border-radius:20px;

    background:
        linear-gradient(
            90deg,
            #087cff,
            #ff1744
        );

    color:white;

    font-weight:bold;

    cursor:pointer;
}

/* =========================================
   PREMIUM SUBSCRIPTION
========================================= */

.subscription-section{
    position:relative;

    padding:
        110px 6%;

    overflow:hidden;

    background:
        radial-gradient(
            circle at 20% 30%,
            rgba(0,110,255,.18),
            transparent 35%
        ),

        radial-gradient(
            circle at 80% 70%,
            rgba(255,0,60,.18),
            transparent 35%
        ),

        #03050d;
}

.subscription-section::before{
    content:"";

    position:absolute;

    inset:0;

    background:
        linear-gradient(
            120deg,
            transparent 40%,
            rgba(0,120,255,.06),
            transparent 60%
        );

    animation:
        premiumSweep 7s linear infinite;

    pointer-events:none;
}

@keyframes premiumSweep{

    0%{
        transform:translateX(-100%);
    }

    100%{
        transform:translateX(100%);
    }

}

.subscription-header{
    position:relative;

    text-align:center;

    max-width:750px;

    margin:
        0 auto 55px;
}

.premium-badge{
    display:inline-block;

    padding:8px 18px;

    border-radius:30px;

    font-size:12px;

    font-weight:900;

    letter-spacing:2px;

    color:white;

    background:
        linear-gradient(
            90deg,
            #087cff,
            #ff1744
        );

    box-shadow:
        0 0 20px
        rgba(0,120,255,.35),

        0 0 30px
        rgba(255,0,60,.25);

    margin-bottom:20px;
}

.subscription-header h2{
    font-size:
        clamp(
            35px,
            5vw,
            65px
        );

    line-height:1.05;

    margin-bottom:18px;
}

.subscription-header h2 span{
    background:
        linear-gradient(
            90deg,
            #087cff,
            #ffffff,
            #ff1744
        );

    -webkit-background-clip:text;

    color:transparent;
}

.subscription-header p{
    color:#aebbd0;

    font-size:17px;

    line-height:1.7;
}

.pricing-grid{
    position:relative;

    max-width:1200px;

    margin:auto;

    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:25px;
}

.price-card{
    position:relative;

    padding:35px 28px;

    border-radius:25px;

    background:
        linear-gradient(
            145deg,
            rgba(10,18,38,.95),
            rgba(4,7,18,.95)
        );

    border:
        1px solid
        rgba(40,130,255,.25);

    box-shadow:
        0 20px 60px
        rgba(0,0,0,.35);

    transition:
        transform .4s,
        border-color .4s,
        box-shadow .4s;

    overflow:hidden;
}

.price-card::before{
    content:"";

    position:absolute;

    width:180px;
    height:180px;

    top:-90px;
    right:-90px;

    background:#087cff;

    filter:blur(90px);

    opacity:.18;
}

.price-card:hover{
    transform:
        translateY(-12px)
        scale(1.02);

    border-color:#087cff;

    box-shadow:
        0 0 25px
        rgba(0,110,255,.3),

        0 25px 70px
        rgba(0,0,0,.5);
}

.price-card.popular{
    border-color:#ff1744;

    box-shadow:
        0 0 35px
        rgba(255,23,68,.18);
}

.popular-label{
    position:absolute;

    top:0;
    left:0;
    right:0;

    text-align:center;

    padding:9px;

    font-size:11px;

    font-weight:900;

    letter-spacing:2px;

    background:
        linear-gradient(
            90deg,
            #087cff,
            #ff1744
        );
}

.plan-icon{
    font-size:42px;

    margin-bottom:18px;
}

.price-card h3{
    font-size:27px;

    margin-bottom:12px;
}

.price{
    font-size:42px;

    font-weight:900;

    margin-bottom:12px;
}

.price span{
    font-size:15px;

    color:#168cff;

    vertical-align:top;
}

.price small{
    font-size:13px;

    color:#7e8ba4;

    font-weight:normal;
}

.plan-description{
    color:#9ba8bf;

    margin-bottom:25px;

    line-height:1.6;
}

.price-card ul{
    list-style:none;

    margin-bottom:28px;
}

.price-card li{
    padding:9px 0;

    color:#d9e1ef;

    font-size:14px;
}

.subscribe-btn{
    width:100%;

    padding:15px;

    border:none;

    border-radius:30px;

    cursor:pointer;

    color:white;

    font-weight:900;

    font-size:15px;

    background:
        linear-gradient(
            90deg,
            #087cff,
            #ff1744
        );

    box-shadow:
        0 0 20px
        rgba(0,110,255,.2);

    transition:.3s;
}

.subscribe-btn:hover{
    transform:translateY(-3px);

    box-shadow:
        0 0 30px
        rgba(0,120,255,.45),

        0 0 40px
        rgba(255,0,50,.2);
}

.payment-note{
    position:relative;

    text-align:center;

    margin-top:35px;

    color:#7f8da5;

    font-size:13px;
}

/* =========================================
   FEATURED
========================================= */

.featured{
    background:
        linear-gradient(
            90deg,
            rgba(0,80,255,.18),
            rgba(255,0,50,.15)
        ),
        rgba(5,8,18,.8);

    border-top:
        1px solid
        rgba(0,120,255,.2);

    border-bottom:
        1px solid
        rgba(255,0,50,.2);
}

.feature-box{
    display:grid;

    grid-template-columns:
        1fr 1fr;

    gap:40px;

    align-items:center;
}

.feature-box img{
    width:100%;

    border-radius:20px;

    box-shadow:
        0 0 40px
        rgba(0,110,255,.25);
}

.feature-box h2{
    font-size:45px;

    margin-bottom:15px;
}

.feature-box p{
    color:#b4bfd2;

    line-height:1.7;
}

/* =========================================
   ABOUT
========================================= */

.about{
    text-align:center;

    max-width:850px;

    margin:auto;
}

.about p{
    color:#aab5c9;

    line-height:1.8;
}

/* =========================================
   MODAL
========================================= */

.modal{
    display:none;

    position:fixed;

    inset:0;

    z-index:3000;

    background:
        rgba(0,0,0,.92);

    align-items:center;

    justify-content:center;

    padding:20px;
}

.modal.active{
    display:flex;
}

.modal-box{
    width:min(900px,100%);

    background:#060a15;

    border:
        1px solid #087cff;

    border-radius:20px;

    padding:15px;

    box-shadow:
        0 0 50px
        rgba(0,100,255,.3);

    position:relative;
}

.modal iframe{
    width:100%;

    height:500px;

    border:none;

    border-radius:12px;
}

.close{
    position:absolute;

    right:-10px;

    top:-15px;

    width:40px;
    height:40px;

    border-radius:50%;

    border:none;

    background:#ff1744;

    color:white;

    font-size:22px;

    cursor:pointer;
}

/* =========================================
   FOOTER
========================================= */

footer{
    text-align:center;

    padding:35px;

    border-top:
        1px solid
        rgba(0,100,255,.2);

    color:#7f8ba2;
}

footer strong{
    color:#168cff;
}

/* =========================================
   MOBILE
========================================= */

@media(max-width:850px){

    header{
        flex-wrap:wrap;
    }

    nav{
        order:3;

        width:100%;

        justify-content:center;

        gap:15px;
    }

    .search{
        margin-left:auto;
    }

    .pricing-grid{
        grid-template-columns:1fr;

        max-width:500px;
    }

    .feature-box{
        grid-template-columns:1fr;
    }

    .feature-box h2{
        font-size:35px;
    }

    .modal iframe{
        height:300px;
    }

}

@media(max-width:500px){

    .movie-grid{
        grid-template-columns:
            repeat(2,1fr);

        gap:12px;
    }

    .poster{
        height:230px;
    }

    .movie-info{
        padding:10px;
    }

    .movie-info h3{
        font-size:15px;
    }

    .hero{
        padding-left:5%;
        padding-right:5%;
    }

    .search input{
        width:130px;
    }

}

</style>
</head>

