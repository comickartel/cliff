<script>

/* =========================================
   TRAILER
========================================= */

function openTrailer(videoId){

    const modal =
        document.getElementById(
            "trailerModal"
        );

    const frame =
        document.getElementById(
            "trailerFrame"
        );

    frame.src =
        "https://www.youtube.com/embed/" +
        videoId +
        "?autoplay=1";

    modal.classList.add("active");

}


/* =========================================
   CLOSE TRAILER
========================================= */

function closeTrailer(){

    const modal =
        document.getElementById(
            "trailerModal"
        );

    const frame =
        document.getElementById(
            "trailerFrame"
        );

    frame.src = "";

    modal.classList.remove(
        "active"
    );

}


/* =========================================
   ESCAPE KEY
========================================= */

document
    .getElementById("trailerModal")
    .addEventListener(
        "click",
        function(e){

            if(e.target === this){

                closeTrailer();

            }

        }
    );


document.addEventListener(
    "keydown",
    function(e){

        if(e.key === "Escape"){

            closeTrailer();

        }

    }
);


/* =========================================
   FILTER MOVIES
========================================= */

function filterMovies(
    category,
    button
){

    document
        .querySelectorAll(".filter")
        .forEach(btn => {

            btn.classList.remove(
                "active"
            );

        });

    button.classList.add(
        "active"
    );


    document
        .querySelectorAll(".movie")
        .forEach(movie => {

            if(
                category === "all" ||
                movie.dataset.category
                    .includes(category)
            ){

                movie.style.display = "";

            }else{

                movie.style.display =
                    "none";

            }

        });

}


/* =========================================
   SEARCH
========================================= */

function searchMovies(){

    const query =
        document
            .getElementById(
                "searchInput"
            )
            .value
            .toLowerCase()
            .trim();


    document
        .querySelectorAll(".movie")
        .forEach(movie => {

            const title =
                movie.dataset.title
                    .toLowerCase();


            movie.style.display =
                title.includes(query)
                    ? ""
                    : "none";

        });

}


/* =========================================
   LIVE SEARCH
========================================= */

document
    .getElementById(
        "searchInput"
    )
    .addEventListener(
        "input",
        searchMovies
    );


/* =========================================
   HEADER SCROLL EFFECT
========================================= */

window.addEventListener(
    "scroll",
    function(){

        const header =
            document.getElementById(
                "header"
            );


        if(window.scrollY > 50){

            header.style.background =
                "rgba(2,5,15,.97)";

            header.style.boxShadow =
                "0 5px 30px rgba(0,80,255,.2)";

        }else{

            header.style.background =
                "rgba(2,5,15,.82)";

            header.style.boxShadow =
                "none";

        }

    }
);


/* =========================================
   PAYSTACK PAYMENT
========================================= */

function startPayment(
    amount,
    plan
){

    const email = prompt(
        "Enter your email address to continue:"
    );


    if(!email){

        return;

    }


    if(!email.includes("@")){

        alert(
            "Please enter a valid email address."
        );

        return;

    }


    /*
       IMPORTANT:

       Replace the value below with your
       Paystack PUBLIC key.

       Example:

       key: "pk_test_xxxxxxxxxxxxx"

       NEVER put your secret key here.
    */

    const popup =
        new PaystackPop();


    popup.newTransaction({

        key:
            "YOUR_PAYSTACK_PUBLIC_KEY",

        email:
            email,

        amount:
            amount * 100,

        currency:
            "KES",

        metadata:{

            custom_fields:[

                {
                    display_name:
                        "Subscription Plan",

                    variable_name:
                        "subscription_plan",

                    value:
                        plan
                }

            ]

        },


        onSuccess:
            function(transaction){

                alert(

                    "🎉 PAYMENT SUCCESSFUL!\n\n" +

                    "Plan: " +
                    plan +

                    "\nAmount: KES " +
                    amount +

                    "\nReference: " +
                    transaction.reference

                );

                console.log(
                    transaction
                );

            },


        onCancel:
            function(){

                alert(
                    "Payment cancelled."
                );

            },


        onError:
            function(error){

                alert(
                    "Payment error: " +
                    error.message
                );

                console.error(
                    error
                );

            }

    });

}

</script>

