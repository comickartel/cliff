<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Rayolla Tech</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Arial,Helvetica,sans-serif;
}

:root{
  --bg:#050816;
  --card:#0d1428;
  --card2:#111c36;
  --text:#fff;
  --muted:#9ba8c7;
  --blue:#00aaff;
  --red:#ff1744;
  --border:#26375d;
}

body{
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
  overflow-x:hidden;
}

/* Animated background */

body::before{
  content:"";
  position:fixed;
  width:500px;
  height:500px;
  background:var(--blue);
  opacity:.08;
  filter:blur(120px);
  border-radius:50%;
  top:-150px;
  left:-100px;
  animation:moveGlow 8s infinite alternate;
  z-index:-1;
}

body::after{
  content:"";
  position:fixed;
  width:500px;
  height:500px;
  background:var(--red);
  opacity:.07;
  filter:blur(120px);
  border-radius:50%;
  right:-150px;
  bottom:-150px;
  animation:moveGlow2 10s infinite alternate;
  z-index:-1;
}

@keyframes moveGlow{
  from{transform:translate(0,0)}
  to{transform:translate(250px,180px)}
}

@keyframes moveGlow2{
  from{transform:translate(0,0)}
  to{transform:translate(-200px,-150px)}
}

/* Header */

header{
  position:sticky;
  top:0;
  z-index:100;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:18px 7%;
  background:rgba(5,8,22,.88);
  backdrop-filter:blur(15px);
  border-bottom:1px solid var(--border);
}

.logo{
  font-size:26px;
  font-weight:900;
  letter-spacing:1px;
}

.logo span{
  color:var(--blue);
}

.logo::after{
  content:"";
  display:inline-block;
  width:8px;
  height:8px;
  margin-left:7px;
  background:var(--red);
  border-radius:50%;
  box-shadow:0 0 15px var(--red);
  animation:blink 1s infinite;
}

@keyframes blink{
  50%{opacity:.2}
}

nav{
  display:flex;
  gap:22px;
}

nav a{
  color:var(--muted);
  text-decoration:none;
  font-weight:bold;
  transition:.3s;
}

nav a:hover{
  color:var(--blue);
}

.header-buttons{
  display:flex;
  gap:10px;
}

.icon-btn{
  border:1px solid var(--border);
  background:var(--card);
  color:white;
  width:42px;
  height:42px;
  border-radius:50%;
  cursor:pointer;
  font-size:18px;
}

/* Hero */

.hero{
  min-height:520px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  padding:70px 20px;
}

.hero h1{
  font-size:clamp(45px,8vw,90px);
  line-height:1;
  margin-bottom:20px;
}

.gradient{
  background:linear-gradient(90deg,var(--blue),#fff,var(--red));
  -webkit-background-clip:text;
  color:transparent;
  background-size:200%;
  animation:gradient 5s infinite;
}

@keyframes gradient{
  50%{background-position:100%}
}

.hero p{
  max-width:650px;
  color:var(--muted);
  font-size:18px;
  line-height:1.7;
}

.hero-buttons{
  display:flex;
  gap:15px;
  margin-top:30px;
  flex-wrap:wrap;
  justify-content:center;
}

.btn{
  padding:14px 25px;
  border-radius:10px;
  border:none;
  cursor:pointer;
  font-weight:bold;
  color:white;
  background:linear-gradient(90deg,var(--blue),#006eff);
  box-shadow:0 0 25px #00aaff33;
}

.btn.red{
  background:linear-gradient(90deg,var(--red),#ff004c);
}

/* Sections */

section{
  width:90%;
  max-width:1200px;
  margin:0 auto 80px;
}

.section-title{
  text-align:center;
  margin-bottom:35px;
}

.section-title h2{
  font-size:35px;
}

.section-title p{
  color:var(--muted);
  margin-top:10px;
}

/* Search */

.search-box{
  max-width:700px;
  margin:auto;
  display:flex;
  background:var(--card);
  border:1px solid var(--border);
  border-radius:14px;
  padding:8px;
}

.search-box input{
  flex:1;
  background:transparent;
  border:none;
  outline:none;
  color:white;
  padding:14px;
  font-size:16px;
}

.search-box button{
  background:var(--blue);
  color:white;
  border:none;
  border-radius:9px;
  padding:0 20px;
  cursor:pointer;
}

/* Cards */

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:20px;
}

.card{
  background:linear-gradient(145deg,var(--card),var(--card2));
  border:1px solid var(--border);
  border-radius:18px;
  padding:25px;
  transition:.3s;
  position:relative;
  overflow:hidden;
}

.card::before{
  content:"";
  position:absolute;
  width:100px;
  height:100px;
  background:var(--blue);
  filter:blur(70px);
  opacity:.1;
  top:-30px;
  right:-30px;
}

.card:hover{
  transform:translateY(-8px);
  border-color:var(--blue);
  box-shadow:0 10px 35px #0008;
}

.card-icon{
  font-size:35px;
  margin-bottom:15px;
}

.card h3{
  margin-bottom:10px;
}

.card p{
  color:var(--muted);
  line-height:1.6;
}

.card button{
  margin-top:18px;
  padding:10px 15px;
  border:none;
  border-radius:8px;
  background:#182542;
  color:white;
  cursor:pointer;
}

/* Stats */

.stats{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
  gap:15px;
}

.stat{
  text-align:center;
  padding:25px;
  background:var(--card);
  border:1px solid var(--border);
  border-radius:15px;
}

.stat h2{
  color:var(--blue);
  font-size:35px;
}

.stat p{
  color:var(--muted);
  margin-top:7px;
}

/* Tools */

.tool{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:18px;
  padding:25px;
}

.tool textarea{
  width:100%;
  height:130px;
  resize:none;
  background:#060b19;
  color:white;
  border:1px solid var(--border);
  border-radius:10px;
  padding:15px;
  margin:15px 0;
  outline:none;
}

.tool-result{
  padding:15px;
  border-radius:10px;
  background:#080e20;
  color:var(--muted);
  min-height:45px;
}

/* Vocabulary */

.vocab{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:16px;
  margin-bottom:10px;
  background:var(--card);
  border:1px solid var(--border);
  border-radius:10px;
}

.vocab strong{
  color:var(--blue);
}

/* Notification */

.notification{
  position:fixed;
  right:20px;
  bottom:20px;
  background:var(--card2);
  border:1px solid var(--blue);
  padding:18px 22px;
  border-radius:12px;
  display:none;
  z-index:500;
  box-shadow:0 0 30px #0008;
}

/* Footer */

footer{
  text-align:center;
  padding:40px 20px;
  border-top:1px solid var(--border);
  color:var(--muted);
}

footer strong{
  color:var(--blue);
}

/* Mobile */

@media(max-width:700px){
  header{
    padding:15px 4%;
  }

  nav{
    display:none;
  }

  .hero{
    min-height:470px;
  }

  .hero h1{
    font-size:50px;
  }

  section{
    width:92%;
  }
}
</style>
</head>

<body>

<header>

  <div class="logo">
    Rayolla <span>Tech</span>
  </div>

  <nav>
    <a href="#home">Home</a>
    <a href="#tools">Tools</a>
    <a href="#topics">Topics</a>
    <a href="#vocabulary">Vocabulary</a>
  </nav>

  <div class="header-buttons">
    <button class="icon-btn" onclick="toggleTheme()">🌙</button>
    <button class="icon-btn" onclick="showNotification()">🔔</button>
  </div>

</header>


<!-- HERO -->

<div class="hero" id="home">

  <h1>
    Welcome to<br>
    <span class="gradient">Rayolla Tech</span>
  </h1>

  <p>
    Explore technology, cybersecurity, programming, artificial
    intelligence, networking and digital innovation in one modern
    technology hub.
  </p>

  <div class="hero-buttons">
    <button class="btn" onclick="scrollToSection('topics')">
      Explore Tech
    </button>

    <button class="btn red" onclick="scrollToSection('tools')">
      Open Tools
    </button>
  </div>

</div>


<!-- SEARCH -->

<section>

  <div class="section-title">
    <h2>🔎 Tech Search</h2>
    <p>Search the Rayolla Tech knowledge base.</p>
  </div>

  <div class="search-box">

    <input
      id="searchInput"
      type="text"
      placeholder="Search cybersecurity, AI, coding..."
      onkeyup="searchTech()"
    >

    <button onclick="searchTech()">Search</button>

  </div>

  <div id="searchResults" style="margin-top:20px;"></div>

</section>


<!-- STATS -->

<section>

  <div class="stats">

    <div class="stat">
      <h2>50+</h2>
      <p>Tech Topics</p>
    </div>

    <div class="stat">
      <h2>100+</h2>
      <p>Vocabulary Terms</p>
    </div>

    <div class="stat">
      <h2>20+</h2>
      <p>Technology Tools</p>
    </div>

    <div class="stat">
      <h2>24/7</h2>
      <p>Learning</p>
    </div>

  </div>

</section>


<!-- TOPICS -->

<section id="topics">

  <div class="section-title">
    <h2>🚀 Technology Topics</h2>
    <p>Discover different areas of modern technology.</p>
  </div>

  <div class="grid">

    <div class="card">
      <div class="card-icon">🤖</div>
      <h3>Artificial Intelligence</h3>
      <p>Explore AI, machine learning, neural networks and intelligent systems.</p>
      <button onclick="topic('Artificial Intelligence')">Explore</button>
    </div>

    <div class="card">
      <div class="card-icon">🛡️</div>
      <h3>Cybersecurity</h3>
      <p>Learn about digital security, threats, defense and safe computing.</p>
      <button onclick="topic('Cybersecurity')">Explore</button>
    </div>

    <div class="card">
      <div class="card-icon">💻</div>
      <h3>Programming</h3>
      <p>Discover HTML, CSS, JavaScript, Python and modern software development.</p>
      <button onclick="topic('Programming')">Explore</button>
    </div>

    <div class="card">
      <div class="card-icon">🌐</div>
      <h3>Networking</h3>
      <p>Understand networks, protocols, servers, IP addresses and the internet.</p>
      <button onclick="topic('Networking')">Explore</button>
    </div>

    <div class="card">
      <div class="card-icon">☁️</div>
      <h3>Cloud Computing</h3>
      <p>Learn about cloud infrastructure, storage, platforms and services.</p>
      <button onclick="topic('Cloud Computing')">Explore</button>
    </div>

    <div class="card">
      <div class="card-icon">📱</div>
      <h3>Mobile Technology</h3>
      <p>Explore smartphones, mobile apps, operating systems and mobile development.</p>
      <button onclick="topic('Mobile Technology')">Explore</button>
    </div>

    <div class="card">
      <div class="card-icon">🎮</div>
      <h3>Game Development</h3>
      <p>Discover game engines, graphics, programming and interactive experiences.</p>
      <button onclick="topic('Game Development')">Explore</button>
    </div>

    <div class="card">
      <div class="card-icon">🔬</div>
      <h3>Future Tech</h3>
      <p>Explore robotics, quantum computing, AR, VR and emerging technologies.</p>
      <button onclick="topic('Future Technology')">Explore</button>
    </div>

  </div>

</section>


<!-- TOOLS -->

<section id="tools">

  <div class="section-title">
    <h2>🧰 Tech Tools</h2>
    <p>Useful browser-based utilities.</p>
  </div>

  <div class="grid">

    <!-- Password generator -->

    <div class="tool">

      <h3>🔐 Password Generator</h3>

      <p style="color:var(--muted);margin-top:8px;">
        Generate a random password.
      </p>

      <button class="btn" onclick="generatePassword()" style="margin-top:15px;">
        Generate
      </button>

      <div class="tool-result" id="passwordResult" style="margin-top:15px;">
        Your password will appear here.
      </div>

    </div>


    <!-- Text analyzer -->

    <div class="tool">

      <h3>📝 Text Analyzer</h3>

      <textarea
        id="textInput"
        placeholder="Enter text here..."
        oninput="analyzeText()"
      ></textarea>

      <div class="tool-result" id="textResult">
        Characters: 0 | Words: 0
      </div>

    </div>


    <!-- Color generator -->

    <div class="tool">

      <h3>🎨 Color Generator</h3>

      <p style="color:var(--muted);margin:10px 0;">
        Generate a random HEX color.
      </p>

      <button class="btn" onclick="generateColor()">
        Generate Color
      </button>

      <div class="tool-result" id="colorResult" style="margin-top:15px;">
        #000000
      </div>

    </div>

  </div>

</section>


<!-- VOCABULARY -->

<section id="vocabulary">

  <div class="section-title">
    <h2>📚 Tech Vocabulary</h2>
    <p>Important technology terms.</p>
  </div>

  <div id="vocabList">

    <div class="vocab">
      <strong>AI</strong>
      <span>Artificial Intelligence</span>
    </div>

    <div class="vocab">
      <strong>API</strong>
      <span>Application Programming Interface</span>
    </div>

    <div class="vocab">
      <strong>CPU</strong>
      <span>Central Processing Unit</span>
    </div>

    <div class="vocab">
      <strong>RAM</strong>
      <span>Random Access Memory</span>
    </div>

    <div class="vocab">
      <strong>IP</strong>
      <span>Internet Protocol</span>
    </div>

    <div class="vocab">
      <strong>VPN</strong>
      <span>Virtual Private Network</span>
    </div>

    <div class="vocab">
      <strong>DNS</strong>
      <span>Domain Name System</span>
    </div>

    <div class="vocab">
      <strong>HTML</strong>
      <span>HyperText Markup Language</span>
    </div>

    <div class="vocab">
      <strong>CSS</strong>
      <span>Cascading Style Sheets</span>
    </div>

    <div class="vocab">
      <strong>JS</strong>
      <span>JavaScript</span>
    </div>

  </div>

</section>


<!-- CLOCK -->

<section>

  <div class="section-title">

    <h2>🕒 Rayolla Tech System Clock</h2>

    <p id="clock">
      Loading...
    </p>

  </div>

</section>


<footer>

  <p>
    © 2026 <strong>Rayolla Tech</strong>
  </p>

  <p style="margin-top:8px;">
    Technology • Innovation • Cybersecurity • AI
  </p>

</footer>


<div class="notification" id="notification">
  🔔 Welcome to Rayolla Tech!
</div>


<script>

/* Smooth scrolling */

function scrollToSection(id){

  document.getElementById(id).scrollIntoView({
    behavior:"smooth"
  });

}


/* Topic buttons */

function topic(name){

  showNotification("🚀 Exploring " + name);

}


/* Notification */

function showNotification(message="🔔 Rayolla Tech notification"){

  const box=document.getElementById("notification");

  box.textContent=message;

  box.style.display="block";

  setTimeout(()=>{
    box.style.display="none";
  },3000);

}


/* Theme */

function toggleTheme(){

  const root=document.documentElement;

  const current=getComputedStyle(root)
    .getPropertyValue("--bg")
    .trim();

  if(current==="#050816"){

    root.style.setProperty("--bg","#f1f5f9");
    root.style.setProperty("--card","#ffffff");
    root.style.setProperty("--card2","#e8eef7");
    root.style.setProperty("--text","#101827");
    root.style.setProperty("--muted","#536176");
    root.style.setProperty("--border","#cbd5e1");

    document.body.style.color="#101827";

  }else{

    root.style.setProperty("--bg","#050816");
    root.style.setProperty("--card","#0d1428");
    root.style.setProperty("--card2","#111c36");
    root.style.setProperty("--text","#fff");
    root.style.setProperty("--muted","#9ba8c7");
    root.style.setProperty("--border","#26375d");

    document.body.style.color="white";

  }

}


/* Password generator */

function generatePassword(){

  const chars=
  "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*";

  let password="";

  for(let i=0;i<18;i++){

    password += chars[
      Math.floor(Math.random()*chars.length)
    ];

  }

  document.getElementById("passwordResult").textContent=password;

}


/* Text analyzer */

function analyzeText(){

  const text=document.getElementById("textInput").value;

  const characters=text.length;

  const words=text.trim()===""
    ?0
    :text.trim().split(/\s+/).length;

  document.getElementById("textResult").textContent=
    "Characters: "+characters+
    " | Words: "+words;

}


/* Color generator */

function generateColor(){

  const letters="0123456789ABCDEF";

  let color="#";

  for(let i=0;i<6;i++){

    color += letters[
      Math.floor(Math.random()*16)
    ];

  }

  document.getElementById("colorResult").textContent=color;

  document.getElementById("colorResult").style.color=color;

}


/* Live clock */

function updateClock(){

  const now=new Date();

  document.getElementById("clock").textContent=
    now.toLocaleString();

}

setInterval(updateClock,1000);

updateClock();


/* Search */

const techData=[

  {
    name:"Artificial Intelligence",
    keywords:"ai artificial intelligence machine learning neural networks"
  },

  {
    name:"Cybersecurity",
    keywords:"cybersecurity hacking security malware phishing firewall"
  },

  {
    name:"Programming",
    keywords:"programming html css javascript python code software"
  },

  {
    name:"Networking",
    keywords:"network networking router ip dns server internet"
  },

  {
    name:"Cloud Computing",
    keywords:"cloud aws storage server computing infrastructure"
  },

  {
    name:"Mobile Technology",
    keywords:"mobile android ios smartphone applications apps"
  },

  {
    name:"Game Development",
    keywords:"games gaming unity unreal engine graphics"
  },

  {
    name:"Future Technology",
    keywords:"robotics quantum vr ar future innovation"
  }

];


function searchTech(){

  const query=
    document.getElementById("searchInput")
    .value
    .toLowerCase()
    .trim();

  const results=
    document.getElementById("searchResults");

  if(!query){

    results.innerHTML="";

    return;

  }

  const matches=techData.filter(item=>
    item.name.toLowerCase().includes(query) ||
    item.keywords.includes(query)
  );

  if(matches.length===0){

    results.innerHTML=`
      <div class="card">
        <h3>🔎 No results</h3>
        <p>
          Try searching for AI, cybersecurity,
          programming, networking or cloud.
        </p>
      </div>
    `;

    return;

  }

  results.innerHTML=matches.map(item=>`

    <div class="card" style="margin-top:12px">

      <h3>💡 ${item.name}</h3>

      <p>
        This topic is available in the
        Rayolla Tech technology hub.
      </p>

      <button onclick="topic('${item.name}')">
        Explore
      </button>

    </div>

  `).join("");

}


/* Keyboard shortcut */

document.addEventListener("keydown",function(event){

  if(event.key==="/"){

    event.preventDefault();

    document.getElementById("searchInput").focus();

  }

});

</script>

</body>
</html>
